# ---------------------------------------------------------------------------
# CinéMood — variables d'environnement
# Copie ce fichier en « .env.local » pour le développement local,
# et recopie chaque valeur dans Vercel → Settings → Environment Variables.
# AUCUNE de ces valeurs ne doit être commitée dans Git.
# ---------------------------------------------------------------------------

# --- TMDB (obligatoire pour les vraies données) ----------------------------
# themoviedb.org → Paramètres → API → « API Read Access Token » (v4, long).
# Utilisé UNIQUEMENT côté serveur.
TMDB_ACCESS_TOKEN=

# Région utilisée pour les disponibilités streaming et les classifications d'âge.
TMDB_REGION=FR
TMDB_LANGUE=fr-FR

# --- Supabase (obligatoire pour les comptes et la sauvegarde) --------------
# supabase.com → ton projet → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ Ne JAMAIS exposer la clé « service_role » côté navigateur.

# --- Claude (facultatif : phrases « Pourquoi pour toi » rédigées par l'IA) --
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Mode démo --------------------------------------------------------------
# « 1 » = l'app tourne sur un catalogue local, sans TMDB ni Supabase.
# Laisse vide (ou « 0 ») dès que TMDB et Supabase sont configurés.
NEXT_PUBLIC_MODE_DEMO=1
