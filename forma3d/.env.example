# Copier en .env.local (ignoré par git) et remplir les valeurs.
# Sans les variables Supabase, le site démarre en « mode démo » (rien n'est sauvegardé).

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique (publishable / anon) : faite pour le navigateur, protégée par la RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (secret / service_role) : serveur uniquement, jamais préfixée NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- IA (serveur uniquement) ---
# Peut aussi être saisie dans /admin/cles (stockée chiffrée en base).
ANTHROPIC_API_KEY=

# Chiffrement des clés saisies dans /admin/cles (AES-256-GCM).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY=

# Protège /setup sur un déploiement public : le jeton est demandé pour créer le compte admin.
SETUP_TOKEN=

# --- Optionnels ---
# Fournisseur text-to-3D (expérimental) : clé Meshy, aussi saisissable dans /admin/cles.
MESHY_API_KEY=
# URL publique du site (liens de confirmation d'email). Ex. : https://forma3d.vercel.app
NEXT_PUBLIC_SITE_URL=
