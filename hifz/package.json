{
  "name": "hifz",
  "version": "0.1.0",
  "private": true,
  "description": "Hifz — mémorisation du Coran verset par verset, avec répétition espacée.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "data:fetch": "node scripts/fetch-quran.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:auth": "node scripts/smoke-auth.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "next": "16.4.2",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "fake-indexeddb": "6.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "overrides": {
    "vite": "7.3.7"
  }
}
