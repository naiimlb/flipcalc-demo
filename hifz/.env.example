# Comptes et synchronisation (Supabase). Valeurs publiques : l'accès aux données est protégé
# par la sécurité par ligne de la base. Sans ces deux variables, l'app fonctionne en mode local,
# sans compte, et toutes les données restent sur l'appareil.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
