{"number":109,"basmala":true,"ayahs":[{"n":1,"g":6208,"ar":"قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ","fr":"Dis: «O vous les infidèles!","juz":30,"page":603},{"n":2,"g":6209,"ar":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","fr":"Je n'adore pas ce que vous adorez.","juz":30,"page":603},{"n":3,"g":6210,"ar":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","fr":"Et vous n'êtes pas adorateurs de ce que j'adore.","juz":30,"page":603},{"n":4,"g":6211,"ar":"وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ","fr":"Je ne suis pas adorateur de ce que vous adorez.","juz":30,"page":603},{"n":5,"g":6212,"ar":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","fr":"Et vous n'êtes pas adorateurs de ce que j'adore.","juz":30,"page":603},{"n":6,"g":6213,"ar":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","fr":"A vous votre religion, et à moi ma religion».","juz":30,"page":603}]}