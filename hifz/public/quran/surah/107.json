{"number":107,"basmala":true,"ayahs":[{"n":1,"g":6198,"ar":"أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","fr":"Vois-tu celui qui traite de mensonge la Rétribution?","juz":30,"page":602},{"n":2,"g":6199,"ar":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","fr":"C'est bien lui qui repousse l'orphelin,","juz":30,"page":602},{"n":3,"g":6200,"ar":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","fr":"et qui n'encourage point à nourrir le pauvre.","juz":30,"page":602},{"n":4,"g":6201,"ar":"فَوَيْلٌۭ لِّلْمُصَلِّينَ","fr":"Malheur donc, à ceux qui prient","juz":30,"page":602},{"n":5,"g":6202,"ar":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","fr":"tout en négligeant (et retardant) leur Salât,","juz":30,"page":602},{"n":6,"g":6203,"ar":"ٱلَّذِينَ هُمْ يُرَآءُونَ","fr":"qui sont pleins d'ostentation,","juz":30,"page":602},{"n":7,"g":6204,"ar":"وَيَمْنَعُونَ ٱلْمَاعُونَ","fr":"et refusent l'ustensile (à celui qui en a besoin).","juz":30,"page":602}]}