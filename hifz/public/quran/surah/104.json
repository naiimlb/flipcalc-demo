{"number":104,"basmala":true,"ayahs":[{"n":1,"g":6180,"ar":"وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ","fr":"Malheur à tout calomniateur diffamateur,","juz":30,"page":601},{"n":2,"g":6181,"ar":"ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ","fr":"qui amasse une fortune et la compte,","juz":30,"page":601},{"n":3,"g":6182,"ar":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","fr":"pensant que sa fortune l'immortalisera.","juz":30,"page":601},{"n":4,"g":6183,"ar":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","fr":"Mais non! Il sera certes, jeté dans la Hutamah.","juz":30,"page":601},{"n":5,"g":6184,"ar":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","fr":"Et qui te dira ce qu'est la Hutamah?","juz":30,"page":601},{"n":6,"g":6185,"ar":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","fr":"Le Feu attisé d'Allah","juz":30,"page":601},{"n":7,"g":6186,"ar":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","fr":"qui monte jusqu'aux cœurs.","juz":30,"page":601},{"n":8,"g":6187,"ar":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ","fr":"Il se refermera sur eux,","juz":30,"page":601},{"n":9,"g":6188,"ar":"فِى عَمَدٍۢ مُّمَدَّدَةٍۭ","fr":"en colonnes (de flammes) étendues.","juz":30,"page":601}]}