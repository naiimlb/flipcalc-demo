{"number":94,"basmala":true,"ayahs":[{"n":1,"g":6091,"ar":"أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","fr":"N'avons-Nous pas ouvert pour toi ta poitrine?","juz":30,"page":596},{"n":2,"g":6092,"ar":"وَوَضَعْنَا عَنكَ وِزْرَكَ","fr":"Et ne t'avons-Nous pas déchargé du fardeau","juz":30,"page":596},{"n":3,"g":6093,"ar":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","fr":"qui accablait ton dos?","juz":30,"page":596},{"n":4,"g":6094,"ar":"وَرَفَعْنَا لَكَ ذِكْرَكَ","fr":"Et exalté pour toi ta renommée?","juz":30,"page":596},{"n":5,"g":6095,"ar":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","fr":"A côté de la difficulté est, certes, une facilité!","juz":30,"page":596},{"n":6,"g":6096,"ar":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا","fr":"A côté de la difficulté est, certes, une facilité!","juz":30,"page":596},{"n":7,"g":6097,"ar":"فَإِذَا فَرَغْتَ فَٱنصَبْ","fr":"Quand tu te libères, donc, lève-toi,","juz":30,"page":596},{"n":8,"g":6098,"ar":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","fr":"et à ton Seigneur aspire.","juz":30,"page":596}]}