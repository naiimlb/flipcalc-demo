{"number":108,"basmala":true,"ayahs":[{"n":1,"g":6205,"ar":"إِنَّآ أَعْطَيْنَٰكَ ٱلْكَوْثَرَ","fr":"Nous t'avons certes, accordé l'Abondance.","juz":30,"page":602},{"n":2,"g":6206,"ar":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ","fr":"Accomplis la Salât pour ton Seigneur et sacrifie.","juz":30,"page":602},{"n":3,"g":6207,"ar":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ","fr":"Celui qui te hait sera certes, sans postérité.","juz":30,"page":602}]}