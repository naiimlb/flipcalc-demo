{"number":96,"basmala":true,"ayahs":[{"n":1,"g":6107,"ar":"ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","fr":"Lis, au nom de ton Seigneur qui a créé,","juz":30,"page":597},{"n":2,"g":6108,"ar":"خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ","fr":"qui a créé l'homme d'une adhérence.","juz":30,"page":597},{"n":3,"g":6109,"ar":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","fr":"Lis! Ton Seigneur est le Très Noble,","juz":30,"page":597},{"n":4,"g":6110,"ar":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","fr":"qui a enseigné par la plume [le calame],","juz":30,"page":597},{"n":5,"g":6111,"ar":"عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ","fr":"a enseigné à l'homme ce qu'il ne savait pas.","juz":30,"page":597},{"n":6,"g":6112,"ar":"كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ","fr":"Prenez-garde! Vraiment l'homme devient rebelle,","juz":30,"page":597},{"n":7,"g":6113,"ar":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","fr":"dès qu'il estime qu'il peut se suffire à lui-même (à cause de sa richesse).","juz":30,"page":597},{"n":8,"g":6114,"ar":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","fr":"Mais, c'est vers ton Seigneur qu'est le retour.","juz":30,"page":597},{"n":9,"g":6115,"ar":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","fr":"As-tu vu celui qui interdit","juz":30,"page":597},{"n":10,"g":6116,"ar":"عَبْدًا إِذَا صَلَّىٰٓ","fr":"à un serviteur d'Allah [Muhammad] de célébrer la Salât?","juz":30,"page":597},{"n":11,"g":6117,"ar":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","fr":"Vois-tu s'il est sur la bonne voie,","juz":30,"page":597},{"n":12,"g":6118,"ar":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","fr":"ou s'il ordonne la piété?","juz":30,"page":597},{"n":13,"g":6119,"ar":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","fr":"Vois-tu s'il dément et tourne le dos?","juz":30,"page":597},{"n":14,"g":6120,"ar":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","fr":"Ne sait-il pas que vraiment Allah voit?","juz":30,"page":597},{"n":15,"g":6121,"ar":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","fr":"Mais non! S'il ne cesse pas, Nous le saisirons certes, par le toupet,","juz":30,"page":597},{"n":16,"g":6122,"ar":"نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ","fr":"le toupet d'un menteur, d'un pécheur.","juz":30,"page":597},{"n":17,"g":6123,"ar":"فَلْيَدْعُ نَادِيَهُۥ","fr":"Qu'il appelle donc son assemblée.","juz":30,"page":597},{"n":18,"g":6124,"ar":"سَنَدْعُ ٱلزَّبَانِيَةَ","fr":"Nous appellerons les gardiens [de l'Enfer].","juz":30,"page":597},{"n":19,"g":6125,"ar":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","fr":"Non! Ne lui obéis pas; mais prosterne-toi et rapproche-toi.","juz":30,"page":597,"sajda":true}]}