{"number":112,"basmala":true,"ayahs":[{"n":1,"g":6222,"ar":"قُلْ هُوَ ٱللَّهُ أَحَدٌ","fr":"Dis: «Il est Allah, Unique.","juz":30,"page":604},{"n":2,"g":6223,"ar":"ٱللَّهُ ٱلصَّمَدُ","fr":"Allah, Le Seul à être imploré pour ce que nous désirons.","juz":30,"page":604},{"n":3,"g":6224,"ar":"لَمْ يَلِدْ وَلَمْ يُولَدْ","fr":"Il n'a jamais engendré, n'a pas été engendré non plus.","juz":30,"page":604},{"n":4,"g":6225,"ar":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","fr":"Et nul n'est égal à Lui».","juz":30,"page":604}]}