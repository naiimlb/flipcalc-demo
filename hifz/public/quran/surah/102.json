{"number":102,"basmala":true,"ayahs":[{"n":1,"g":6169,"ar":"أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","fr":"La course aux richesses vous distrait,","juz":30,"page":600},{"n":2,"g":6170,"ar":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","fr":"jusqu'à ce que vous visitiez les tombes.","juz":30,"page":600},{"n":3,"g":6171,"ar":"كَلَّا سَوْفَ تَعْلَمُونَ","fr":"Mais non! Vous saurez bientôt!","juz":30,"page":600},{"n":4,"g":6172,"ar":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","fr":"(Encore une fois)! Vous saurez bientôt!","juz":30,"page":600},{"n":5,"g":6173,"ar":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","fr":"Sûrement! Si vous saviez de science certaine.","juz":30,"page":600},{"n":6,"g":6174,"ar":"لَتَرَوُنَّ ٱلْجَحِيمَ","fr":"Vous verrez, certes, la Fournaise.","juz":30,"page":600},{"n":7,"g":6175,"ar":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","fr":"Puis, vous la verrez certes, avec l'œil de la certitude.","juz":30,"page":600},{"n":8,"g":6176,"ar":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","fr":"Puis, assurément, vous serez interrogés, ce jour-là, sur les délices.","juz":30,"page":600}]}