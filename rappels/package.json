{
  "name": "hashtag-rappels",
  "version": "0.1.0",
  "private": true,
  "description": "Rappels de tâches pour les caissiers de Hashtag Bangers (PWA iPhone).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
