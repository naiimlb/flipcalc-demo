# Copie ce fichier en `.env.local` (jamais commité). Guides : docs/COMPTES.md et docs/NOTIFICATIONS.md

# --- Supabase (publiques par conception : la sécurité vient des règles RLS de la base) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Notifications push (facultatif en local) ---
# `npx web-push generate-vapid-keys` : la clé publique est publique, la clé privée est SECRÈTE.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact affiché aux services de push (mailto: ou https:). Facultatif.
VAPID_SUBJECT=
# Secret partagé avec le planificateur (`openssl rand -hex 32`) : le même dans le Vault de Supabase (hb_cron_secret).
CRON_SECRET=
